# AI öğretmen — ÜCRETSİZ (önerilen): Groq (xAI Grok DEĞİL)
# iPhone Safari: https://console.groq.com → kayıt → API Keys → Create
# Anahtar gsk_ ile başlamalı — xai- ile başlayan xAI Grok anahtarı çalışmaz
GROQ_API_KEY=gsk_...

# Alternatif ücretsiz: Google Gemini (Groq limit dolunca otomatik yedek)
# https://aistudio.google.com/apikey — yeni anahtarlar AQ. ile başlar
GEMINI_API_KEY=AQ....
GEMINI_MODEL=gemini-3.5-flash-lite

# Ücretli alternatif: OpenAI
# OPENAI_API_KEY=sk-...

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 yaparsanız sunucu her başlangıçta (ve URL değişince) Telegram'a link gönderir — varsayılan 0
TELEGRAM_NOTIFY_ON_START=0
